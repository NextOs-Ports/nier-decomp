# Current NextOS Linux sysroot, never the Android NDK or a legacy glibc SDK.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT DEFINED ENV{NEXTOS_TOOLCHAIN})
    message(FATAL_ERROR "Set NEXTOS_TOOLCHAIN to the current firmware toolchain directory")
endif()
file(REAL_PATH "$ENV{NEXTOS_TOOLCHAIN}" NEXTOS_TOOLCHAIN)
set(CMAKE_SYSROOT "${NEXTOS_TOOLCHAIN}/aarch64-libreelec-linux-gnu/sysroot")
if(NOT EXISTS "${CMAKE_SYSROOT}/usr/include/SDL3/SDL.h")
    message(FATAL_ERROR "Current target sysroot with SDL3 headers is required")
endif()
find_program(CMAKE_C_COMPILER clang REQUIRED NO_CMAKE_FIND_ROOT_PATH)
find_program(CMAKE_CXX_COMPILER clang++ REQUIRED NO_CMAKE_FIND_ROOT_PATH)
set(CMAKE_C_COMPILER_TARGET aarch64-libreelec-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-libreelec-linux-gnu)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_ASM_COMPILER_TARGET aarch64-libreelec-linux-gnu)
set(CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN "${NEXTOS_TOOLCHAIN}")
set(CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN "${NEXTOS_TOOLCHAIN}")
set(CMAKE_C_FLAGS_INIT "-march=armv8-a")
set(CMAKE_CXX_FLAGS_INIT "-march=armv8-a")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_LINKER_TYPE LLD)
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
